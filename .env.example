# OpenAI is the only paid/external dependency. Everything else runs locally for free.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
AI_API_BEARER_TOKEN=replace-with-long-random-token-at-least-32-chars
TELEPHONY_TWILIO_AUTH_TOKEN=replace-with-twilio-webhook-auth-token
TELEPHONY_WEBHOOK_BASE_URL=
TELEPHONY_REQUIRE_SIGNATURE=true
TELEPHONY_AI_TIMEOUT_MS=12000

PORT=3000

SHOP_NAME=Reliable Shop Systems
SHOP_ADDRESS=123 Main St, Your City
MOBILE_RADIUS_MILES=25
DIAGNOSTIC_FEE_POLICY=Diagnostic fee is $99, waived if repair is completed with us.
PAYMENT_METHODS=Cash, card, and financing through Synchrony.
AFTER_HOURS_POLICY=Leave a message and we will call back the next business day.
